react -> nodejs [label="同源 HTTP(S) / JSON"];
vite -> react [style=dotted, label="构建"];
pwa -> react [style=dotted];
nodejs -> {validation auth worker}; worker -> {cli skills hybrid};
hybrid -> {embed db}; nodejs -> db; db -> disk;
