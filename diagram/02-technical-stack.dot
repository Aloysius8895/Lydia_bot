 db [label="PGlite 0.3.16 + pgvector
嵌入式 PostgreSQL WASM / SQL / JSONB", fillcolor="#FEF3C7"];
 disk [label="本地文件系统
.runtime/data · skills · cases", fillcolor="#FEF3C7"];
}
