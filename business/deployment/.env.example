# Optional: use node --env-file=deployment/.env --experimental-strip-types backend/server.ts
HOST=127.0.0.1
PORT=4318
# Must match the browser origin. HTTPS is required when accessing from a phone.
APP_ORIGIN=http://127.0.0.1:4318
# Local loopback access opens directly. Set false to restore local password login.
LYDIA_LOCAL_AUTO_LOGIN=true
LLM_PROVIDER=claude_cli
CLAUDE_AUTH_MODE=subscription
# Only set true after verifying subscription extra usage is disabled in official account settings.
SUBSCRIPTION_NO_OVERAGE_CONFIRMED=false
CLAUDE_TIMEOUT_MS=180000
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text:latest
# Optional explicit full path; otherwise claude is resolved on PATH.
# CLAUDE_EXECUTABLE=C:\Users\User\.local\bin\claude.exe
# HTTPS_KEY_FILE=deployment/certs/crew-key.pem
# HTTPS_CERT_FILE=deployment/certs/crew-cert.pem
# Optional free-search configuration; all conditions must be supplied, no default credits.
TAVILY_FREE_ONLY_CONFIRMED=false
TAVILY_ACCOUNT_ID=
TAVILY_CREDIT_PERIOD=
TAVILY_CREDITS_REMAINING=0
TAVILY_BALANCE_CHECKED_AT=
# TAVILY_API_KEY=
# Optional cloud TTS credential. Alternatively enter it in Settings > Voice.
# Selecting a configured ElevenLabs voice sends answer text to ElevenLabs and uses account credits.
# The default provider remains browser speech until explicitly selected in Settings > Voice.
# ELEVENLABS_API_KEY=

# X official API: app-only Bearer Token from X Developer Console.
# Reads may consume paid API credits. Keep the real value only in your private env file.
X_BEARER_TOKEN=

# Optional remote control channel. Leave unset to keep the local app unchanged.
# The relay URL must be public https. Do not point it at this computer.
# LYDIA_RELAY_URL=
# Server-side only. Required before remote tasks can be stored. Never put these in frontend code.
# LYDIA_COORDINATION_DATABASE_URL=
# LYDIA_RELAY_BOOTSTRAP_TOKEN=
# LYDIA_OWNER_PASSWORD=
